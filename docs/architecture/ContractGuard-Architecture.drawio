=none;strokeColor=#7D8998;" vertex="1" parent="1"><mxGeometry x="10" y="1250" width="2580" height="270" as="geometry" /></mxCell><mxCell id="legend_t" value="&lt;b&gt;Main flow (numbers on arrows)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1260" width="600" height="24" as="geometry" /></mxCell><mxCell id="lg_b1" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1296" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t1" value="Users open the app through Amazon CloudFront; the web frontend is served from Amazon S3." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="1292" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b2" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1330" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t2" value="API calls go through CloudFront to the Application Load Balancer in the VPC, then to the API on Amazon ECS Fargate." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="1326" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b3" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1364" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t3" value="Contracts are uploaded straight to Amazon S3 with a signed URL, without passing through the server." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="1360" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b4" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1398" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t4" value="The API sends analysis requests and chat questions to Amazon SQS." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="1394" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b5" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1296" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t5" value="The AI worker on Amazon EC2 takes jobs from SQS, tracks their status in DynamoDB and sends the file to document processing (PDF / DOCX reading, chunking); the content goes to the 3 AI agents." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1348" y="1292" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b6" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1330" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t6" value="LangGraph orchestrates the 3 AI agents; the agents call a language model API chosen by the AI team and look up legal sources through MCP (Qdrant, Supabase, Tavily)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1348" y="1326" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b7" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1364" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t7" value="The worker writes the result to S3 and reports through SQS; the API validates it, stores it in Supabase and shows it to the user." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1348" y="1360" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b8" value="8" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1398" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t8" value="Amazon EventBridge sends scheduled law update commands to SQS; the data pipeline collects legal texts from vanban.chinhphu.vn, keeps the originals on S3 and updates the legal knowledge base." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1348" y="1394" width="1230" height="28" as="geometry" /></mxCell><mxCell id="proxy" value="Egress proxy (Squid)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="2159" y="244" width="56" height="56" as="geometry" /></mxCell><mxCell id="igw" value="Internet Gateway&lt;br&gt;→ Internet" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="2159" y="630" width="56" height="56" as="geometry" /></mxCell><mxCell id="endpoints" value="VPC endpoints&lt;br&gt;S3 · SQS · DynamoDB&lt;br&gt;Secrets Manager · SSM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="2159" y="760" width="56" height="56" as="geometry" /></mxCell><mxCell id="e_compose_proxy" value="&lt;span style=&quot;background:#232F3E;color:#FFFFFF;font-weight:bold;border-radius:9px;padding:1px 6px;&quot;&gt;9&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.03;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="compose" target="proxy"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e_proxy_igw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="igw"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="e_ec2_endpoints" value="AWS APIs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.97;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ai_ec2" target="endpoints"><mxGeometry x="0" relative="1" as="geometry" /></mxCell><mxCell id="lg_b9" value="9" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1432" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t9" value="The worker runs in a private subnet with no route to the Internet: AWS services through VPC endpoints, everything else through the egress proxy (hostname allowlist)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="58" y="1428" width="1230" height="28" as="geometry" /></mxCell><mxCell id="lg_b10" value="10" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1432" width="20" height="20" as="geometry" /></mxCell><mxCell id="lg_t10" value="Users can stop a running analysis: the API sends a cancel command on its own queue and the worker stops the job. The AI machines run only while the web app runs." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1348" y="1428" width="1230" height="28" as="geometry" /></mxCell><mxCell id="ssm" value="AWS Systems Manager&lt;br&gt;Session Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry as="geometry" x="2120" y="925" width="56" height="56" /></mxCell><mxCell id="admin" value="Administrators" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry as="geometry" x="2440" y="923" width="60" height="60" /></mxCell><mxCell id="e_admin_ssm" value="&lt;span style=&quot;background:#232F3E;color:#FFFFFF;font-weight:bold;border-radius:9px;padding:1px 6px;&quot;&gt;11&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="ssm"><mxGeometry as="geometry" x="0" relative="1" /></mxCell><mxCell id="e_ssm_ec2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9633;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ssm" target="ai_ec2"><mxGeometry as="geometry" x="0" relative="1"><Array as="points"><mxPoint x="2060" y="953" /></Array></mxGeometry></mxCell><mxCell id="lg_b11" value="11" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1466" width="20" height="20" /></mxCell><mxCell id="lg_t11" value="Administrators reach the AI EC2 only through AWS Systems Manager Session Manager (SSM VPC endpoints): no SSH, no inbound port, no public IP." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="58" y="1462" width="1230" height="28" /></mxCell></root></mxGraphModel></diagram></mxfile>