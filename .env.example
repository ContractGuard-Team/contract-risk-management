# =====================================================================================================
# Contract Risk Management — ONE env file for the whole project (Docker services + EC2 data pipeline).
# Tracked template only. Real values go in the root .env (gitignored, same layout):
#   local:  python scripts/init_env.py   (creates .env with random tokens, fixture model, worker idle)
#   EC2:    cp .env.example .env         (no API keys in this file: they come from AWS Secrets Manager, section 3)
# Each key appears once. Docker Compose passes every service only the keys it uses (docker-compose.yml).
# =====================================================================================================

# --- 1. Runtime -------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=contract-risk
IMAGE_TAG=local
# production | local (local allows MODEL_PROVIDER=fixture)
APP_ENV=production
# openai | fixture
MODEL_PROVIDER=openai
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=3600

# --- 2. AWS -----------------------------------------------------------------------------------------
# On EC2 credentials come from the instance role: leave the access keys empty.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional AWS-compatible endpoint for emulator tests only. Leave empty on EC2.
AWS_ENDPOINT_URL=

# --- 3. Secrets: AWS Secrets Manager (never written in this file) ------------------------------------
# All API keys/tokens live ONLY in this JSON secret: INTERNAL_API_TOKEN, MCP_API_TOKEN, OPENAI_API_KEY,
# TAVILY_API_KEY, QDRANT_URL, QDRANT_API_KEY, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
# LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY. Services get their own keys from the Config service at start
# (config/policy.json); the data pipeline reads the secret directly. Needs AWS credentials (EC2 instance role).
API_KEYS_SECRET_ID=contract-risk/prod/api-keys

# --- 4. Config service tokens (host-only bootstrap; never in Secrets Manager) -----------------------
# One random token (>= 32 chars) per service, used to ask the Config service for its keys.
# scripts/init_env.py generates them; on EC2: python -c "import secrets; print(secrets.token_urlsafe(32))".
CONFIG_TOKEN_WORKER=
CONFIG_TOKEN_INPUT_PROCESSING=
CONFIG_TOKEN_AGENT_1=
CONFIG_TOKEN_AGENT_2=
CONFIG_TOKEN_AGENT_3=
CONFIG_TOKEN_LANGGRAPH=
CONFIG_TOKEN_MONITORING=
CONFIG_TOKEN_MCP=

# --- 5. Agents (OpenAI) -----------------------------------------------------------------------------
OPENAI_MODEL=
# Optional per-agent model overrides
AGENT_1_MODEL=
AGENT_2_MODEL=
AGENT_3_MODEL=

# --- 6. Contract worker (SQS -> S3 -> DynamoDB) -----------------------------------------------------
WORKER_ENABLED=false
WORKER_SQS_QUEUE_URL=
WORKER_DYNAMODB_TABLE=contract-risk-jobs
WORKER_DYNAMODB_EVENTS_TABLE=contract-risk-job-events
WORKER_INPUT_BUCKET=
WORKER_OUTPUT_BUCKET=
WORKER_OUTPUT_PREFIX=results

# --- 7. MCP gateway and RAG (Agent 2/3 tools) -------------------------------------------------------
# Read-only reference buckets for s3_list_objects/s3_get_object (comma-separated).
MCP_S3_BUCKETS=contract-risk-database-unique-333596350642-ap-southeast-1-an
QDRANT_COLLECTION=legal_documents
# Optional comma-separated allowlist of Supabase tables agents may read.
SUPABASE_TABLES=
# Optional read-only PostgreSQL for postgres_query.
POSTGRES_DSN=
TAVILY_SEARCH_DEPTH=basic
TAVILY_COUNTRY=vietnam
# legal_search rerank model (local, ~1.1 GB; empty = keep hybrid fusion order).
RAG_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Embedding model shared by the MCP gateway and the data pipeline (must match the Qdrant collection size).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
# Models are pre-downloaded into <repo>/models (python scripts/download_models.py) and copied to EC2 with the repo;
# 1 = never download at runtime (mcp mounts ./models read-only; the pipeline reads it from the repo).
HF_HUB_OFFLINE=1

# --- 8. Monitoring and Langfuse ---------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Monitoring pushes job events to the worker's durable inbox; the worker owns AWS writes.
MONITORING_WORKER_ENABLED=true
MONITORING_RETENTION_DAYS=30
# Host port (127.0.0.1 only) of the monitoring service, for the data pipeline running outside Docker.
MONITORING_HOST_PORT=8099
# Optional https webhook (e.g. Slack incoming webhook).
ALERT_WEBHOOK_URL=
ALERT_SLOW_STAGE_MS=900000
ALERT_THROTTLE_COUNT=3
ALERT_THROTTLE_WINDOW_MINUTES=10

# --- 9. Legal data pipeline (EC2 systemd, own venv, NOT Docker) ---------------------------------------
# Reads this same file (DATA_PIPELINE_ENV_FILE overrides) and AWS_REGION, QDRANT_COLLECTION, EMBEDDING_*, LOG_LEVEL
# above; QDRANT_URL/QDRANT_API_KEY/SUPABASE_URL/SUPABASE_SECRET_KEY come from Secrets Manager (section 3).
DATA_SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/333596350642/contract-data-update-queue
DATA_SQS_WAIT_SECONDS=20
DATA_SQS_VISIBILITY_SECONDS=900
# Hiến pháp (typegroupid=1) and Luật/Bộ luật (typegroupid=3)
SOURCE_LIST_URLS=https://vanban.chinhphu.vn/he-thong-van-ban?classid=1&mode=1&typegroupid=1,https://vanban.chinhphu.vn/he-thong-van-ban?classid=1&mode=1&typegroupid=3
CRAWL_DELAY_SECONDS=1
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT_SECONDS=60
CRAWL_USER_AGENT=contract-risk-data-collector/1.0
# Original files only, by law number (legal/{khoa}/{nam}/{so}-{nam}-{khoa}/source/...).
DATA_S3_BUCKET=contract-risk-database-unique-333596350642-ap-southeast-1-an
DATA_S3_PREFIX=legal
# Pre-downloaded models (relative = from the repo root); HuggingFace still needs a writable home (StateDirectory).
EMBEDDING_CACHE_DIR=models
HF_HOME=/var/lib/contract-risk/models/huggingface
HF_HUB_DISABLE_TELEMETRY=1
# Tesseract language and DPI for scanned PDFs (tesseract-ocr-vie on the host).
OCR_LANG=vie
OCR_DPI=300
# Processor service: poll interval (seconds) for failed jobs to retry (re-downloaded from the web).
PROCESSOR_INTERVAL_SECONDS=60
# Send pipeline events to monitoring (logs/metrics/alerts/Langfuse); empty = terminal/journald logs only.
DATA_MONITORING_URL=http://127.0.0.1:8099
