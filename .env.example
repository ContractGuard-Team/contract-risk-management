# TODO: Export AWS/Bedrock values into the process environment.
# Required for a real call; values can also be supplied through BedrockSettings/config.yaml.
AWS_REGION=
BEDROCK_MODEL_ID=
# Optional AWS credential chain: profile, environment credentials, or IAM role.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# TODO: Optional per-agent overrides; blank values fall back to the global settings.
AGENT_1_MODEL_ID=
AGENT_1_REGION=
AGENT_1_PROFILE=
AGENT_2_MODEL_ID=
AGENT_2_REGION=
AGENT_2_PROFILE=
AGENT_3_MODEL_ID=
AGENT_3_REGION=
AGENT_3_PROFILE=
# Langfuse reads these values from root .env; process environment overrides them.
# Never put real keys in this template. Keep local credentials in ignored .env.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Optional: true includes model/tool content; false records structural summaries only.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=
